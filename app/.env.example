# ---- 서버 ----
NODE_ENV=production
PORT=3000
# 반드시 길고 무작위한 값으로 변경 (예: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# ---- 데이터 / 업로드 (Docker 볼륨 square-data:/data 에 영구 저장) ----
DB_PATH=/data/square.db
UPLOAD_DIR=/data/uploads

# ---- NEIS 교육정보 개방 포털 (https://open.neis.go.kr) : 급식/시간표 ----
# 1) open.neis.go.kr 가입 후 인증키 발급
# 2) 학교기본정보 API로 청주고등학교의 표준학교코드(SD_SCHUL_CODE) 조회
NEIS_API_KEY=
NEIS_ATPT_OFCDC_SC_CODE=M10        # 충청북도교육청
NEIS_SD_SCHUL_CODE=                # 청주고등학교 표준학교코드

# ---- 회원가입 학생 인증코드 (쉼표 구분, 운영정책에 맞게) ----
SIGNUP_CODES=

# ---- Cloudflare Tunnel (docker-compose 루트 .env 에 둠) ----
TUNNEL_TOKEN=
