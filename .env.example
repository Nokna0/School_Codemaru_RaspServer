# ===== 루트 .env 템플릿 (docker compose 가 읽어 컨테이너에 주입) =====
# 사용법: 파이의 저장소 루트(docker-compose.yml 옆)에서
#   cp .env.example .env   후 아래 값을 채운다. (.env 는 gitignore — 절대 커밋 금지)

# 인증 서명키: 반드시 길고 무작위하게. 파이에서 생성: openssl rand -hex 32
JWT_SECRET=

# NEIS 급식/시간표. 학교코드만 있으면 키 없이도 동작(한도 낮음). 한도↑ 원하면 키 발급.
NEIS_API_KEY=
NEIS_ATPT_OFCDC_SC_CODE=M10
NEIS_SD_SCHUL_CODE=8000066

# 회원가입 코드(평문, 쉼표구분) — 운영은 보통 비움(관리자 발급=해시 저장). 개발/초기엔 사용 가능.
SIGNUP_CODES=

# Cloudflare Tunnel 토큰 (대시보드에서 발급)
TUNNEL_TOKEN=
